generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Product {
  id           Int         @id @default(autoincrement())
  name         String
  description  String
  price        Float
  oldPrice     Float?
  image        String
  category     String
  collection   String
  ageGroup     String
  stock        Int         @default(0)
  createdAt    DateTime    @default(now())
  isBestSeller Boolean     @default(false)
  isNewArrival Boolean     @default(false)
  eventTag     String?

  // comma-separated lists, e.g. "S,M,L,XL" and "Black,White"
  sizes        String      @default("S,M,L,XL")
  colors       String      @default("Black")
  // JSON text mapping each color to its photo, e.g. {"Black":"https://...","White":"data:image/..."}
  colorImages  String      @default("{}")


  cartItems    CartItem[]
  orderItems   OrderItem[]
  wishlistItems WishlistItem[]
}

model User {
  id        Int        @id @default(autoincrement())
  name      String
  email     String     @unique
  password  String
  isAdmin   Boolean    @default(false)
  createdAt DateTime   @default(now())

  cartItems CartItem[]
  orders    Order[]
  wishlist  WishlistItem[]
}

model CartItem {
  id        Int      @id @default(autoincrement())
  quantity  Int      @default(1)
  size      String?
  color     String?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])
  userId    Int

  product   Product  @relation(fields: [productId], references: [id])
  productId Int
}

model Order {
  id        Int         @id @default(autoincrement())
  status    String      @default("pending")
  total     Float
  createdAt DateTime    @default(now())

  // shipping details: where the order is going and who to contact
  shippingName String?
  phone        String?
  address      String?
  city         String?
  postalCode   String?
  country      String?

  user      User        @relation(fields: [userId], references: [id])
  userId    Int

  items     OrderItem[]
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  quantity  Int
  price     Float

  // remember which size/color the customer picked
  size      String?
  color     String?

  order     Order   @relation(fields: [orderId], references: [id])
  orderId   Int

  product   Product @relation(fields: [productId], references: [id])
  productId Int
}

model WishlistItem {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])
  userId    Int

  product   Product  @relation(fields: [productId], references: [id])
  productId Int

  // a customer can only save the same product once
  @@unique([userId, productId])
}